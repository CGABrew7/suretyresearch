---
import type { RankedAgency } from '../lib/ranking';
import { kindLabel } from '../lib/ranking';

interface Props {
  agency: RankedAgency;
}

const { agency } = Astro.props;
const bbb = agency.signals.find((s) => s.key === 'bbb');
const amBest = agency.signals.find((s) => s.key === 'amBest');
const years = agency.foundedYear ? `${2026 - agency.foundedYear} yrs` : null;
const searchText = `${agency.name} ${agency.shortName} ${agency.hqCity} ${agency.tagline}`.toLowerCase();
---

<a
  class:list={['agency-card', { preferred: agency.preferredPartner }]}
  href={`/agencies/${agency.slug}/`}
  data-kind={agency.kind}
  data-categories={agency.categories.join(',')}
  data-states={agency.knownStates.join(',')}
  data-nationwide={agency.servesNationwide ? '1' : '0'}
  data-search={searchText}
>
  <div class="rank-plate">
    <strong>{String(agency.rank).padStart(2, '0')}</strong>
    <span>{agency.preferredPartner ? 'Preferred' : 'Register'}</span>
  </div>
  <div class="card-body">
    <div class="card-meta">
      <span class="pill">{kindLabel(agency.kind)}</span>
      <span class="pill">{agency.hqCity}, {agency.hqState}</span>
      {agency.preferredPartner && <span class="pill seal">Cornerstone Network Preferred Partner</span>}
      {agency.servesNationwide && <span class="pill">Nationwide placement</span>}
    </div>
    <h3>{agency.name}</h3>
    <p>{agency.tagline}</p>
    {agency.preferredPartner && (
      <p class="rank-reason">
        Why #1: Cornerstone Network Preferred Partner — editorial placement, not a star score.
      </p>
    )}
    <div class="signals">
      {agency.preferredPartner && <span>Rank reason: Cornerstone Network Preferred Partner</span>}
      {!agency.preferredPartner && <span>{agency.rankLabel}</span>}
      {bbb && <span>BBB {bbb.value} · {bbb.source}</span>}
      {amBest && <span>AM Best {amBest.value}</span>}
      {years && <span>Founded {agency.foundedYear} ({years})</span>}
    </div>
  </div>
</a>
