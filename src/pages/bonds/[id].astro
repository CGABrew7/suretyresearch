---
import Layout from '../../layouts/Layout.astro';
import AgencyCard from '../../components/AgencyCard.astro';
import AuthorBio from '../../components/AuthorBio.astro';
import data from '../../data/bonds.json';
import { BOND_CATEGORIES, getCategory } from '../../data/categories';
import { filterAgencies } from '../../lib/ranking';
import { sourcesById, type PrimarySourceId } from '../../data/sources';
import { SITE } from '../../data/site';

const bondCitations: Record<string, { answer: string; sourceIds: PrimarySourceId[] }> = {
  "freight-broker": {
    answer:
      "A property broker must have a $75,000 surety bond or trust fund in effect before FMCSA will register the broker. Evidence of the bond is filed on Form BMC-84.",
    sourceIds: ["bmc"],
  },
  performance: {
    answer:
      "Before a federal contract of more than $100,000 is awarded for construction, alteration, or repair of a public building or public work, the contractor must furnish a performance bond and a payment bond.",
    sourceIds: ["miller"],
  },
};

const categoryIds = new Set(BOND_CATEGORIES.map((c) => c.id));
const typeIds = new Set(data.types.map((t) => t.id));

export function getStaticPaths() {
  const fromTypes = data.types.map((t) => ({ params: { id: t.id } }));
  const fromCats = BOND_CATEGORIES.filter((c) => !data.types.some((t) => t.id === c.id)).map((c) => ({
    params: { id: c.id },
  }));
  return [...fromTypes, ...fromCats];
}

const { id } = Astro.params;
const bond = data.types.find((t) => t.id === id);
const category = getCategory(id) ?? BOND_CATEGORIES.find((c) => c.bondTypeIds.includes(id ?? ''));
const isCategoryPage = categoryIds.has(id ?? '');
const isMortgage = id === 'mortgage-broker';
const agencies = filterAgencies({ category: (isCategoryPage ? id : category?.id) as any });

const MORTGAGE_UPDATED = '2026-10-31';

const mortgageAnswer =
  'Jet Insurance Company publishes a $250 annual premium at a flat 0.5% preferred-tier rate for a $50,000 mortgage license bond, and that page includes mortgage broker bonds. Lance Surety Bonds publishes 1% to 3% and $500 to $1,500 a year above a score of 700, 3% to 5% and $1,500 to $2,500 a year for a score from 600 to 699, and 5% to 10% and $2,500 to $5,000 a year at a score of 599 or below, on its $50,000 residential mortgage broker bond at a loan volume of $5,000,001 to $20,000,000. Bryant Surety Bonds publishes 0.75% to 3%, roughly $375 to $1,500 a year, for strong personal credit on a $50,000 bond. GroupLeader publishes 0.75% to 1.5% for excellent credit (700+), with a $50,000 example that might cost $375 to $750 a year, and 1.5% to 3% for average credit (650 to 699), with a $50,000 example that might cost $750 to $1,500 a year.';

const mortgageCostRows: {
  tier: string;
  rate: string;
  cost: string;
  sourceId: PrimarySourceId;
  linkLabel: string;
}[] = [
  {
    tier: 'Preferred tier',
    rate: '0.5%',
    cost: '$250 a year',
    sourceId: 'jet-mortgage',
    linkLabel: 'Jet Insurance Company, mortgage license bond pricing',
  },
  {
    tier: 'Above 700',
    rate: '1% to 3%',
    cost: '$500 to $1,500 a year',
    sourceId: 'lance-il-mortgage',
    linkLabel: 'Lance Surety Bonds, residential mortgage broker bond pricing',
  },
  {
    tier: '600 to 699',
    rate: '3% to 5%',
    cost: '$1,500 to $2,500 a year',
    sourceId: 'lance-il-mortgage',
    linkLabel: 'Lance Surety Bonds, residential mortgage broker bond pricing',
  },
  {
    tier: 'Below 599',
    rate: '5% to 10%',
    cost: '$2,500 to $5,000 a year',
    sourceId: 'lance-il-mortgage',
    linkLabel: 'Lance Surety Bonds, residential mortgage broker bond pricing',
  },
  {
    tier: 'Strong personal credit',
    rate: '0.75% to 3%',
    cost: 'Roughly $375 to $1,500 a year',
    sourceId: 'bryant-mortgage',
    linkLabel: 'Bryant Surety Bonds, mortgage broker bond cost',
  },
  {
    tier: 'Excellent credit (700+)',
    rate: '0.75% to 1.5%',
    cost: 'Might cost $375 to $750 a year',
    sourceId: 'groupleader-mortgage',
    linkLabel: 'GroupLeader, mortgage broker bond rates',
  },
  {
    tier: 'Average credit (650 to 699)',
    rate: '1.5% to 3%',
    cost: 'Might cost $750 to $1,500 a year',
    sourceId: 'groupleader-mortgage',
    linkLabel: 'GroupLeader, mortgage broker bond rates',
  },
];

const mortgageSourceIds: PrimarySourceId[] = [
  'jet-mortgage',
  'lance-il-mortgage',
  'bryant-mortgage',
  'groupleader-mortgage',
];

const mortgageFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  dateModified: MORTGAGE_UPDATED,
  author: {
    '@type': 'Organization',
    name: 'SuretyResearch',
    url: new URL('/about/', SITE.url).toString(),
  },
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How much does a $50,000 mortgage broker bond cost per year?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: mortgageAnswer,
      },
    },
  ],
};

const title = isMortgage
  ? 'Mortgage Broker Bond | SuretyResearch'
  : isCategoryPage && category
    ? `${category.name} bonds | SuretyResearch`
    : `${bond?.name} | SuretyResearch`;

const description = isMortgage
  ? 'Published premium rates and annual dollar costs for a $50,000 mortgage broker bond, by the credit tier each provider prints.'
  : isCategoryPage && category
    ? category.summary
    : `${bond?.name} cost bands: typical ${bond?.typical}. Face ${bond?.bondRange}.`;

const citation = bond ? bondCitations[bond.id] : undefined;
const citationSources = citation ? sourcesById(citation.sourceIds) : [];
---

<Layout
  title={title}
  description={description}
  dateModified={isMortgage ? MORTGAGE_UPDATED : undefined}
  updatedLabel={isMortgage ? 'October 31, 2026' : undefined}
>
  {isMortgage && (
    <Fragment slot="head">
      <script type="application/ld+json" set:html={JSON.stringify(mortgageFaqSchema)} />
    </Fragment>
  )}
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">{category ? `${category.ledger} · ${category.name}` : 'Bond form'}</p>
      <h1>{isCategoryPage && category ? category.name : bond?.name}</h1>
      <p>
        {isMortgage
          ? mortgageAnswer
          : citation
            ? citation.answer
            : isCategoryPage && category
              ? category.summary
              : bond?.description}
      </p>
      {isMortgage && <p class="dates">Updated October 31, 2026</p>}
      <AuthorBio />
      <div class="btn-row">
        <a class="btn btn-brass" href="/agencies/">Open the register</a>
        <a class="btn btn-ghost" href="/agencies/integrity-first-insurance/">Talk to the desk</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {isCategoryPage && category && (
        <div class="prose" style="margin-bottom:28px">
          <h2>Who posts these bonds</h2>
          <p>{category.whoNeeds}</p>
          <h2>What the face and premium look like on this site</h2>
          <p>{category.typicalRange}. Those bands are the ranges published on this register. A licensed desk sets the rate on the file.</p>
        </div>
      )}

      {bond && isMortgage && (
        <>
          <div class="prose" style="margin-bottom:32px">
            <h2>How much does a $50,000 mortgage broker bond cost per year?</h2>
            <p>
              Each row is a credit tier whose source prints both a premium rate and a dollar cost for a $50,000 bond. A tier is left out when that page does not print both figures.
            </p>
            <div class="table-scroll">
              <table class="table cost-table">
                <caption class="sr-only">Annual cost of a $50,000 mortgage broker bond by the credit tier each linked page prints.</caption>
                <thead>
                  <tr>
                    <th scope="col">Credit tier</th>
                    <th scope="col">Premium rate range</th>
                    <th scope="col">Dollar cost</th>
                    <th scope="col">Source</th>
                  </tr>
                </thead>
                <tbody>
                  {mortgageCostRows.map((row) => {
                    const source = sourcesById([row.sourceId])[0];
                    return (
                      <tr>
                        <td data-label="Credit tier">{row.tier}</td>
                        <td data-label="Premium rate range">
                          <a href={source.url} target="_blank" rel="noopener">{row.rate}</a>
                        </td>
                        <td data-label="Dollar cost">
                          <a href={source.url} target="_blank" rel="noopener">{row.cost}</a>
                        </td>
                        <td data-label="Source">
                          <a href={source.url} target="_blank" rel="noopener">{row.linkLabel}</a>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
            <p class="cost-note">
              Jet calls the $250 price preferred-tier pricing and does not print a credit score for it. The same page includes mortgage broker bonds. The Lance rows are that page's $50,000 residential mortgage broker bond at a loan volume of $5,000,001 to $20,000,000. Its dollar columns are labeled Over 700, Between 600 and 699, and Below 599, and the 5% to 10% rate is for a score of 599 or below.
            </p>
            <h3>Sources</h3>
            <ul class="source-list cost-sources">
              {mortgageSourceIds.map((id) => {
                const source = sourcesById([id])[0];
                const linkLabel = mortgageCostRows.find((row) => row.sourceId === id)?.linkLabel ?? source.label;
                return (
                  <li><a href={source.url} target="_blank" rel="noopener">{linkLabel}</a></li>
                );
              })}
            </ul>
            <h2>What this bond covers</h2>
            <p>{bond.description}</p>
            <p>Common uses: {bond.examples}.</p>
            <h2>FAQ</h2>
            <div class="faq-stack">
              <details class="faq-item">
                <summary class="faq-q">How much does a $50,000 mortgage broker bond cost per year?<span aria-hidden="true">+</span></summary>
                <div class="faq-a"><p>{mortgageAnswer}</p></div>
              </details>
            </div>
            <h2>Related pages</h2>
            <ul class="related-links">
              <li><a href="/guides/credit-score-impact/">How a credit score changes a surety premium</a></li>
              <li><a href="/guides/how-surety-bonds-work/">How a surety bond works</a></li>
              <li><a href="/bonds/license-permit/">License and permit bonds, including the mortgage broker form</a></li>
            </ul>
            <h2>Face and premium band on this register</h2>
            <p>The register lists this face range and premium band for the mortgage broker form.</p>
          </div>
          <div class="stat-row" style="margin-bottom:28px">
            <div><strong>{bond.typical}</strong><span>Typical annual premium</span></div>
            <div><strong>{bond.bondRange}</strong><span>Face amount range</span></div>
            <div><strong>{bond.premiumRange}</strong><span>Premium rate band</span></div>
            <div><strong>{bond.creditImpact}</strong><span>Credit sensitivity</span></div>
          </div>
        </>
      )}

      {bond && !isMortgage && (
        <>
          <div class="stat-row" style="margin-bottom:28px">
            <div><strong>{bond.typical}</strong><span>Typical annual premium</span></div>
            <div><strong>{bond.bondRange}</strong><span>Face amount range</span></div>
            <div><strong>{bond.premiumRange}</strong><span>Premium rate band</span></div>
            <div><strong>{bond.creditImpact}</strong><span>Credit sensitivity</span></div>
          </div>

          <div class="prose" style="margin-bottom:32px">
            {citation && (
              <>
                <h2>What the primary source says</h2>
                <p>{citation.answer}</p>
                <ul class="source-list">
                  {citationSources.map((source) => (
                    <li><a href={source.url} target="_blank" rel="noopener">{source.label}</a></li>
                  ))}
                </ul>
              </>
            )}
            <h2>Cost bands by credit</h2>
            <p>
              The table is this site’s premium sketch for a $25,000 face and a $100,000 face. A licensed desk sets the rate on the full file.
            </p>
            <table class="table">
              <thead>
                <tr>
                  <th>Credit range</th>
                  <th>Typical rate</th>
                  <th>$25K face</th>
                  <th>$100K face</th>
                </tr>
              </thead>
              <tbody>
                <tr><td>Excellent (720+)</td><td>1 to 3%</td><td>$250 to $750</td><td>$1,000 to $3,000</td></tr>
                <tr><td>Good (680 to 719)</td><td>2 to 5%</td><td>$500 to $1,250</td><td>$2,000 to $5,000</td></tr>
                <tr><td>Fair (600 to 679)</td><td>5 to 8%</td><td>$1,250 to $2,000</td><td>$5,000 to $8,000</td></tr>
                <tr><td>Below 600</td><td>8 to 15%</td><td>$2,000 to $3,750</td><td>$8,000 to $15,000</td></tr>
              </tbody>
            </table>
            <p>Common uses: {bond.examples}.</p>
          </div>
        </>
      )}

      {isCategoryPage && category && (
        <div class="prose" style="margin-bottom:28px">
          <h2>Forms in this series</h2>
          <p>These are the forms grouped under {category.name}.</p>
          <ul>
            {category.examples.map((ex) => <li>{ex}</li>)}
          </ul>
          <p>
            Related researched forms:
            {category.bondTypeIds
              .filter((tid) => typeIds.has(tid) && tid !== id)
              .map((tid, i, arr) => {
                const t = data.types.find((x) => x.id === tid);
                return t ? (
                  <>
                    <a href={`/bonds/${t.id}/`}>{t.name}</a>
                    {i < arr.length - 1 ? ', ' : ''}
                  </>
                ) : null;
              })}
          </p>
        </div>
      )}

      <div class="section-head">
        <div>
          <p class="kicker">Desks on this series</p>
          <h2>Register entries that list this category</h2>
        </div>
        <p>The cards are the desks and carriers that list this series, sorted by the public-signal score on each card.</p>
      </div>
      <div class="ledger">
        {agencies.slice(0, 8).map((agency) => <AgencyCard agency={agency} />)}
      </div>
      <p style="margin-top:16px">
        <a href={`/agencies/?`}>See the full register</a>
        {' · '}
        <a href="/#calculator">Premium sketch</a>
      </p>
    </div>
  </section>
</Layout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .cost-note {
    color: var(--ink-2);
    margin-top: 8px;
  }

  .cost-table {
    width: 100%;
  }

  .cost-table th {
    font-size: 0.75rem;
  }

  .cost-table td {
    font-size: 1rem;
  }

  .cost-table a {
    display: inline;
  }

  @media (max-width: 720px) {
    .cost-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .cost-table,
    .cost-table tbody,
    .cost-table tr,
    .cost-table td {
      display: block;
      width: 100%;
    }

    .cost-table tr {
      border-bottom: 1px solid var(--rule-strong);
      padding: 12px 0 4px;
    }

    .cost-table td {
      border: 0;
      padding: 4px 0;
    }

    .cost-table td::before {
      content: attr(data-label);
      display: block;
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-3);
      font-weight: 600;
      margin-bottom: 2px;
    }

    .cost-table a,
    .cost-sources a,
    .related-links a {
      display: flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>
