---
import Layout from '../../layouts/Layout.astro';
import AgencyCard from '../../components/AgencyCard.astro';
import AuthorBio from '../../components/AuthorBio.astro';
import data from '../../data/bonds.json';
import { BOND_CATEGORIES, getCategory } from '../../data/categories';
import { filterAgencies } from '../../lib/ranking';
import { sourcesById, type PrimarySourceId } from '../../data/sources';

const bondCitations: Record<string, { answer: string; sourceIds: PrimarySourceId[] }> = {
  "freight-broker": {
    answer:
      "A property broker must have a $75,000 surety bond or trust fund in effect before FMCSA will register the broker. Evidence of the bond is filed on Form BMC-84.",
    sourceIds: ["bmc"],
  },
  performance: {
    answer:
      "Before a federal contract of more than $100,000 is awarded for construction, alteration, or repair of a public building or public work, the contractor must furnish a performance bond and a payment bond.",
    sourceIds: ["miller"],
  },
};

const categoryIds = new Set(BOND_CATEGORIES.map((c) => c.id));
const typeIds = new Set(data.types.map((t) => t.id));

export function getStaticPaths() {
  const fromTypes = data.types.map((t) => ({ params: { id: t.id } }));
  const fromCats = BOND_CATEGORIES.filter((c) => !data.types.some((t) => t.id === c.id)).map((c) => ({
    params: { id: c.id },
  }));
  return [...fromTypes, ...fromCats];
}

const { id } = Astro.params;
const bond = data.types.find((t) => t.id === id);
const category = getCategory(id) ?? BOND_CATEGORIES.find((c) => c.bondTypeIds.includes(id ?? ''));
const isCategoryPage = categoryIds.has(id ?? '');
const agencies = filterAgencies({ category: (isCategoryPage ? id : category?.id) as any });

const title = isCategoryPage && category
  ? `${category.name} bonds — SuretyResearch`
  : `${bond?.name} — SuretyResearch`;

const description = isCategoryPage && category
  ? category.summary
  : `${bond?.name} cost bands: typical ${bond?.typical}. Face ${bond?.bondRange}.`;

const citation = bond ? bondCitations[bond.id] : undefined;
const citationSources = citation ? sourcesById(citation.sourceIds) : [];
---

<Layout title={title} description={description}>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">{category ? `${category.ledger} · ${category.name}` : 'Bond form'}</p>
      <h1>{isCategoryPage && category ? category.name : bond?.name}</h1>
      <p>
        {citation
          ? citation.answer
          : isCategoryPage && category
            ? category.summary
            : bond?.description}
      </p>
      <AuthorBio />
      <div class="btn-row">
        <a class="btn btn-brass" href="/agencies/">Open the register</a>
        <a class="btn btn-ghost" href="/agencies/integrity-first-insurance/">Talk to the desk</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {isCategoryPage && category && (
        <div class="prose" style="margin-bottom:28px">
          <h2>Who posts these bonds</h2>
          <p>{category.whoNeeds}</p>
          <h2>What the face and premium look like on this site</h2>
          <p>{category.typicalRange}. Those bands are the ranges published on this register. A licensed desk sets the rate on the file.</p>
        </div>
      )}

      {bond && (
        <>
          <div class="stat-row" style="margin-bottom:28px">
            <div><strong>{bond.typical}</strong><span>Typical annual premium</span></div>
            <div><strong>{bond.bondRange}</strong><span>Face amount range</span></div>
            <div><strong>{bond.premiumRange}</strong><span>Premium rate band</span></div>
            <div><strong>{bond.creditImpact}</strong><span>Credit sensitivity</span></div>
          </div>

          <div class="prose" style="margin-bottom:32px">
            {citation && (
              <>
                <h2>What the primary source says</h2>
                <p>{citation.answer}</p>
                <ul class="source-list">
                  {citationSources.map((source) => (
                    <li><a href={source.url} target="_blank" rel="noopener">{source.label}</a></li>
                  ))}
                </ul>
              </>
            )}
            <h2>Cost bands by credit</h2>
            <p>
              The table is this site’s premium sketch for a $25,000 face and a $100,000 face. A licensed desk sets the rate on the full file.
            </p>
            <table class="table">
              <thead>
                <tr>
                  <th>Credit range</th>
                  <th>Typical rate</th>
                  <th>$25K face</th>
                  <th>$100K face</th>
                </tr>
              </thead>
              <tbody>
                <tr><td>Excellent (720+)</td><td>1–3%</td><td>$250 – $750</td><td>$1,000 – $3,000</td></tr>
                <tr><td>Good (680–719)</td><td>2–5%</td><td>$500 – $1,250</td><td>$2,000 – $5,000</td></tr>
                <tr><td>Fair (600–679)</td><td>5–8%</td><td>$1,250 – $2,000</td><td>$5,000 – $8,000</td></tr>
                <tr><td>Below 600</td><td>8–15%</td><td>$2,000 – $3,750</td><td>$8,000 – $15,000</td></tr>
              </tbody>
            </table>
            <p>Common uses: {bond.examples}.</p>
          </div>
        </>
      )}

      {isCategoryPage && category && (
        <div class="prose" style="margin-bottom:28px">
          <h2>Forms in this series</h2>
          <p>These are the forms grouped under {category.name}.</p>
          <ul>
            {category.examples.map((ex) => <li>{ex}</li>)}
          </ul>
          <p>
            Related researched forms:
            {category.bondTypeIds
              .filter((tid) => typeIds.has(tid) && tid !== id)
              .map((tid, i, arr) => {
                const t = data.types.find((x) => x.id === tid);
                return t ? (
                  <>
                    <a href={`/bonds/${t.id}/`}>{t.name}</a>
                    {i < arr.length - 1 ? ', ' : ''}
                  </>
                ) : null;
              })}
          </p>
        </div>
      )}

      <div class="section-head">
        <div>
          <p class="kicker">Desks on this series</p>
          <h2>Register entries that list this category</h2>
        </div>
        <p>The cards are the desks and carriers that list this series, sorted by the public-signal score on each card.</p>
      </div>
      <div class="ledger">
        {agencies.slice(0, 8).map((agency) => <AgencyCard agency={agency} />)}
      </div>
      <p style="margin-top:16px">
        <a href={`/agencies/?`}>See the full register</a>
        {' · '}
        <a href="/#calculator">Premium sketch</a>
      </p>
    </div>
  </section>
</Layout>
