---
import Layout from '../../layouts/Layout.astro';
import AgencyCard from '../../components/AgencyCard.astro';
import AuthorBio from '../../components/AuthorBio.astro';
import data from '../../data/bonds.json';
import { BOND_CATEGORIES, getCategory } from '../../data/categories';
import { filterAgencies } from '../../lib/ranking';
import { sourcesById, type PrimarySourceId } from '../../data/sources';
import { SITE } from '../../data/site';

const bondCitations: Record<string, { answer: string; sourceIds: PrimarySourceId[] }> = {
  "freight-broker": {
    answer:
      "A property broker must have a $75,000 surety bond or trust fund in effect before FMCSA will register the broker. Evidence of the bond is filed on Form BMC-84.",
    sourceIds: ["bmc"],
  },
  performance: {
    answer:
      "Before a federal contract of more than $100,000 is awarded for construction, alteration, or repair of a public building or public work, the contractor must furnish a performance bond and a payment bond.",
    sourceIds: ["miller"],
  },
};

const categoryIds = new Set(BOND_CATEGORIES.map((c) => c.id));
const typeIds = new Set(data.types.map((t) => t.id));

export function getStaticPaths() {
  const fromTypes = data.types.map((t) => ({ params: { id: t.id } }));
  const fromCats = BOND_CATEGORIES.filter((c) => !data.types.some((t) => t.id === c.id)).map((c) => ({
    params: { id: c.id },
  }));
  return [...fromTypes, ...fromCats];
}

const { id } = Astro.params;
const bond = data.types.find((t) => t.id === id);
const category = getCategory(id) ?? BOND_CATEGORIES.find((c) => c.bondTypeIds.includes(id ?? ''));
const isCategoryPage = categoryIds.has(id ?? '');
const isMortgage = id === 'mortgage-broker';
const agencies = filterAgencies({ category: (isCategoryPage ? id : category?.id) as any });

const MORTGAGE_UPDATED = '2026-10-22';

const mortgageAnswer =
  'Jet Insurance Company publishes a $250 annual premium for a $50,000 mortgage license bond at its preferred-tier rate of 0.5%, and that page includes mortgage broker bonds. Lance Surety Bonds publishes $500 to $1,500 a year for a score over 700, $1,500 to $2,500 for a score from 600 to 699, and $2,500 to $5,000 for a score below 599 on its $50,000 Illinois residential mortgage broker bond and its $50,000 Ohio minimum. Bryant Surety Bonds publishes 0.5% to 1.25% at a score of 700 or above and roughly $375 to $1,500 a year for strong personal credit on a $50,000 bond, and GroupLeader publishes an example of $375 to $750 a year for excellent credit (700+) and $750 to $1,500 a year for average credit (650 to 699) on a $50,000 bond.';

const mortgageCostRows: { tier: string; premium: string; sourceIds: PrimarySourceId[] }[] = [
  {
    tier: 'Preferred tier',
    premium:
      '$250 a year at 0.5% for a $50,000 mortgage license bond. The same page lists mortgage broker bonds among the licenses this price covers.',
    sourceIds: ['jet-mortgage'],
  },
  {
    tier: 'Over 700',
    premium:
      '$500 to $1,500 a year on the $50,000 bond. The Illinois page states 1% to 3% for a score above 700.',
    sourceIds: ['lance-il-mortgage', 'lance-oh-mortgage'],
  },
  {
    tier: '600 to 699',
    premium:
      '$1,500 to $2,500 a year on the $50,000 bond. The Illinois page states 3% to 5% for a score from 600 to 699.',
    sourceIds: ['lance-il-mortgage', 'lance-oh-mortgage'],
  },
  {
    tier: 'Below 599',
    premium:
      '$2,500 to $5,000 a year on the $50,000 bond. The Illinois page states 5% to 10% for a score of 599 or below.',
    sourceIds: ['lance-il-mortgage', 'lance-oh-mortgage'],
  },
  {
    tier: 'Strong personal credit',
    premium:
      '0.75% to 3% of the bond amount. Bryant prints roughly $375 to $1,500 a year on a $50,000 bond for this tier.',
    sourceIds: ['bryant-mortgage'],
  },
  {
    tier: '700 and above',
    premium:
      '0.5% to 1.25% of the bond amount in the mortgage broker bond column. The Ohio page states this rate for a FICO score of 700 or more.',
    sourceIds: ['bryant-rates', 'bryant-ohio-mortgage'],
  },
  {
    tier: '650 to 699',
    premium: '0.75% to 1.5% of the bond amount, in the mortgage broker bond column.',
    sourceIds: ['bryant-rates'],
  },
  {
    tier: '600 to 649',
    premium: '2% to 5% of the bond amount, in the mortgage broker bond column.',
    sourceIds: ['bryant-rates'],
  },
  {
    tier: '550 to 599',
    premium: '5% to 7.5% of the bond amount, in the mortgage broker bond column.',
    sourceIds: ['bryant-rates'],
  },
  {
    tier: '549 and under',
    premium: '5% to 10% of the bond amount, in the mortgage broker bond column.',
    sourceIds: ['bryant-rates'],
  },
  {
    tier: 'Excellent credit (700+)',
    premium:
      '0.75% to 1.5% of the bond amount. The page example for a $50,000 bond is $375 to $750 a year.',
    sourceIds: ['groupleader-mortgage'],
  },
  {
    tier: 'Average credit (650 to 699)',
    premium:
      '1.5% to 3% of the bond amount. The page example for a $50,000 bond is $750 to $1,500 a year.',
    sourceIds: ['groupleader-mortgage'],
  },
  {
    tier: 'Challenged credit',
    premium: '4% to 10% of the bond amount.',
    sourceIds: ['groupleader-mortgage'],
  },
];

const mortgageSourceIds: PrimarySourceId[] = [
  'jet-mortgage',
  'lance-il-mortgage',
  'lance-oh-mortgage',
  'bryant-mortgage',
  'bryant-rates',
  'bryant-ohio-mortgage',
  'groupleader-mortgage',
];

const mortgageFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  dateModified: MORTGAGE_UPDATED,
  author: {
    '@type': 'Organization',
    name: 'SuretyResearch',
    url: new URL('/about/', SITE.url).toString(),
  },
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How much does a $50,000 mortgage broker bond cost per year?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: mortgageAnswer,
      },
    },
  ],
};

const title = isCategoryPage && category
  ? `${category.name} bonds — SuretyResearch`
  : `${bond?.name} — SuretyResearch`;

const description = isMortgage
  ? 'Published annual premiums for a $50,000 mortgage broker bond, by the credit tier each surety provider prints.'
  : isCategoryPage && category
    ? category.summary
    : `${bond?.name} cost bands: typical ${bond?.typical}. Face ${bond?.bondRange}.`;

const citation = bond ? bondCitations[bond.id] : undefined;
const citationSources = citation ? sourcesById(citation.sourceIds) : [];
---

<Layout
  title={title}
  description={description}
  dateModified={isMortgage ? MORTGAGE_UPDATED : undefined}
  updatedLabel={isMortgage ? 'October 22, 2026' : undefined}
>
  {isMortgage && (
    <Fragment slot="head">
      <script type="application/ld+json" set:html={JSON.stringify(mortgageFaqSchema)} />
    </Fragment>
  )}
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">{category ? `${category.ledger} · ${category.name}` : 'Bond form'}</p>
      <h1>{isCategoryPage && category ? category.name : bond?.name}</h1>
      <p>
        {isMortgage
          ? mortgageAnswer
          : citation
            ? citation.answer
            : isCategoryPage && category
              ? category.summary
              : bond?.description}
      </p>
      {isMortgage && <p class="dates">Updated October 22, 2026</p>}
      <AuthorBio />
      <div class="btn-row">
        <a class="btn btn-brass" href="/agencies/">Open the register</a>
        <a class="btn btn-ghost" href="/agencies/integrity-first-insurance/">Talk to the desk</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {isCategoryPage && category && (
        <div class="prose" style="margin-bottom:28px">
          <h2>Who posts these bonds</h2>
          <p>{category.whoNeeds}</p>
          <h2>What the face and premium look like on this site</h2>
          <p>{category.typicalRange}. Those bands are the ranges published on this register. A licensed desk sets the rate on the file.</p>
        </div>
      )}

      {bond && isMortgage && (
        <>
          <div class="prose" style="margin-bottom:32px">
            <h2>How much does a $50,000 mortgage broker bond cost per year?</h2>
            <p>
              Each row is a credit tier a surety provider printed for a mortgage broker bond, with that provider's rate or $50,000 premium.
              Lance Surety Bonds prints the dollar premiums below for its $50,000 Illinois residential mortgage broker bond, at a loan volume of $5,000,001 to $20,000,000, and for its $50,000 Ohio minimum.
            </p>
            <div class="table-scroll">
              <table class="table cost-table">
                <thead>
                  <tr>
                    <th>Credit tier</th>
                    <th>Published premium</th>
                    <th>Source</th>
                  </tr>
                </thead>
                <tbody>
                  {mortgageCostRows.map((row) => (
                    <tr>
                      <td>{row.tier}</td>
                      <td>{row.premium}</td>
                      <td>
                        {sourcesById(row.sourceIds).map((source) => (
                          <a href={source.url} target="_blank" rel="noopener">{source.label}</a>
                        ))}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <h3>Sources</h3>
            <ul class="source-list cost-sources">
              {sourcesById(mortgageSourceIds).map((source) => (
                <li><a href={source.url} target="_blank" rel="noopener">{source.label}</a></li>
              ))}
            </ul>
            <h2>What this bond covers</h2>
            <p>{bond.description}</p>
            <p>Common uses: {bond.examples}.</p>
            <h2>FAQ</h2>
            <div class="faq-stack">
              <details class="faq-item">
                <summary class="faq-q">How much does a $50,000 mortgage broker bond cost per year?<span aria-hidden="true">+</span></summary>
                <div class="faq-a"><p>{mortgageAnswer}</p></div>
              </details>
            </div>
            <h2>Related pages</h2>
            <ul class="related-links">
              <li><a href="/guides/credit-score-impact/">How a credit score changes a surety premium</a></li>
              <li><a href="/guides/how-surety-bonds-work/">How a surety bond works</a></li>
              <li><a href="/bonds/license-permit/">License and permit bonds, including the mortgage broker form</a></li>
            </ul>
            <h2>Face and premium band on this register</h2>
            <p>The register lists this face range and premium band for the mortgage broker form.</p>
          </div>
          <div class="stat-row" style="margin-bottom:28px">
            <div><strong>{bond.typical}</strong><span>Typical annual premium</span></div>
            <div><strong>{bond.bondRange}</strong><span>Face amount range</span></div>
            <div><strong>{bond.premiumRange}</strong><span>Premium rate band</span></div>
            <div><strong>{bond.creditImpact}</strong><span>Credit sensitivity</span></div>
          </div>
        </>
      )}

      {bond && !isMortgage && (
        <>
          <div class="stat-row" style="margin-bottom:28px">
            <div><strong>{bond.typical}</strong><span>Typical annual premium</span></div>
            <div><strong>{bond.bondRange}</strong><span>Face amount range</span></div>
            <div><strong>{bond.premiumRange}</strong><span>Premium rate band</span></div>
            <div><strong>{bond.creditImpact}</strong><span>Credit sensitivity</span></div>
          </div>

          <div class="prose" style="margin-bottom:32px">
            {citation && (
              <>
                <h2>What the primary source says</h2>
                <p>{citation.answer}</p>
                <ul class="source-list">
                  {citationSources.map((source) => (
                    <li><a href={source.url} target="_blank" rel="noopener">{source.label}</a></li>
                  ))}
                </ul>
              </>
            )}
            <h2>Cost bands by credit</h2>
            <p>
              The table is this site’s premium sketch for a $25,000 face and a $100,000 face. A licensed desk sets the rate on the full file.
            </p>
            <table class="table">
              <thead>
                <tr>
                  <th>Credit range</th>
                  <th>Typical rate</th>
                  <th>$25K face</th>
                  <th>$100K face</th>
                </tr>
              </thead>
              <tbody>
                <tr><td>Excellent (720+)</td><td>1–3%</td><td>$250 – $750</td><td>$1,000 – $3,000</td></tr>
                <tr><td>Good (680–719)</td><td>2–5%</td><td>$500 – $1,250</td><td>$2,000 – $5,000</td></tr>
                <tr><td>Fair (600–679)</td><td>5–8%</td><td>$1,250 – $2,000</td><td>$5,000 – $8,000</td></tr>
                <tr><td>Below 600</td><td>8–15%</td><td>$2,000 – $3,750</td><td>$8,000 – $15,000</td></tr>
              </tbody>
            </table>
            <p>Common uses: {bond.examples}.</p>
          </div>
        </>
      )}

      {isCategoryPage && category && (
        <div class="prose" style="margin-bottom:28px">
          <h2>Forms in this series</h2>
          <p>These are the forms grouped under {category.name}.</p>
          <ul>
            {category.examples.map((ex) => <li>{ex}</li>)}
          </ul>
          <p>
            Related researched forms:
            {category.bondTypeIds
              .filter((tid) => typeIds.has(tid) && tid !== id)
              .map((tid, i, arr) => {
                const t = data.types.find((x) => x.id === tid);
                return t ? (
                  <>
                    <a href={`/bonds/${t.id}/`}>{t.name}</a>
                    {i < arr.length - 1 ? ', ' : ''}
                  </>
                ) : null;
              })}
          </p>
        </div>
      )}

      <div class="section-head">
        <div>
          <p class="kicker">Desks on this series</p>
          <h2>Register entries that list this category</h2>
        </div>
        <p>The cards are the desks and carriers that list this series, sorted by the public-signal score on each card.</p>
      </div>
      <div class="ledger">
        {agencies.slice(0, 8).map((agency) => <AgencyCard agency={agency} />)}
      </div>
      <p style="margin-top:16px">
        <a href={`/agencies/?`}>See the full register</a>
        {' · '}
        <a href="/#calculator">Premium sketch</a>
      </p>
    </div>
  </section>
</Layout>

<style>
  .cost-table {
    width: 100%;
  }

  @media (max-width: 720px) {
    .cost-table {
      min-width: 36rem;
    }
  }

  .cost-table th {
    font-size: 0.75rem;
  }

  .cost-table td {
    font-size: 1rem;
  }

  .cost-table a {
    display: block;
    margin: 4px 0;
  }

  @media (max-width: 640px) {
    .cost-table a,
    .cost-sources a,
    .related-links a {
      display: flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>
