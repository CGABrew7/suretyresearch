---
import Layout from '../../layouts/Layout.astro';
import AuthorBio from '../../components/AuthorBio.astro';
import { BOND_CATEGORIES } from '../../data/categories';
import data from '../../data/bonds.json';
---

<Layout
  title="Bond types | SuretyResearch"
  description="License and permit, contract/performance, commercial, and court bonds, plus cost bands for common forms."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">Bond series</p>
      <h1>Four series. Then the specific forms.</h1>
      <p>
        Start with the series that matches the bond, then open the form page for the face and premium band this site publishes. Placement goes through Integrity First Insurance first.
      </p>
      <AuthorBio />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid-2" style="margin-bottom:36px">
        {BOND_CATEGORIES.map((cat) => (
          <a class="tile" href={`/bonds/${cat.id}/`}>
            <p class="kicker">{cat.ledger}</p>
            <h3>{cat.name}</h3>
            <p>{cat.headline}. {cat.summary}</p>
          </a>
        ))}
      </div>

      <div class="section-head">
        <div>
          <p class="kicker">Common forms</p>
          <h2>Cost bands we already researched</h2>
        </div>
        <p>Each form below opens with the typical premium and face amount published on this site.</p>
      </div>
      <div class="ledger">
        {data.types.map((t) => (
          <a class="agency-card" href={`/bonds/${t.id}/`}>
            <div class="rank-plate">
              <strong>B</strong>
              <span>Form</span>
            </div>
            <div class="card-body">
              <h3>{t.name}</h3>
              <p>{t.description}</p>
              <div class="signals">
                <span>Typical {t.typical}</span>
                <span>Face {t.bondRange}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
