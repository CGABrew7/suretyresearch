---
import Layout from '../layouts/Layout.astro';
import AgencyCard from '../components/AgencyCard.astro';
import AuthorBio from '../components/AuthorBio.astro';
import StatePicker from '../components/StatePicker.astro';
import BondCalculator from '../components/BondCalculator.jsx';
import { rankedDirectory, kindLabel } from '../lib/ranking';
import { BOND_CATEGORIES } from '../data/categories';
import { HOME_FAQS } from '../data/faqs';
import { SITE } from '../data/site';
// Homepage-only stylesheet. Imported here and nowhere else, and every rule in
// it is scoped to the .sr-home wrapper below.
import '../styles/home.css';

const ranked = rankedDirectory();
const featured = ranked.slice(0, 6);
const excerpt = ranked.slice(0, 4);
const ifi = ranked.find((a) => a.preferredPartner) ?? ranked[0];

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: new URL('/', SITE.url).toString(),
  description: SITE.description,
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: new URL('/', SITE.url).toString(),
  },
};
---

<Layout
  title="Surety Bond Agency Register | SuretyResearch"
  description="A ranked surety bond agency register for mortgage, insurance, and contractor professionals, with sources on every card and a premium sketch calculator."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script is:inline>
      /* Entrance motion is opt-in: content is only held back when scripting, IntersectionObserver, and motion are all available. */
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('h-motion');
      }
    </script>
  </Fragment>

  <div class="sr-home">
    <section class="h-hero">
      <div class="h-wrap h-hero-title">
        <h1>
          <span class="h-t1"><span>Surety bond agencies, ranked </span></span>
          <span class="h-t2"><span>for mortgage, insurance, and contractor pros</span></span>
        </h1>
      </div>

      <aside class="h-mast" aria-label="Opening lines of the register">
        <header class="h-mast-head">
          <p class="h-note">Opening lines</p>
          <p class="h-mast-count"><strong>{ranked.length}</strong> <span>desks on file</span></p>
        </header>
        <ol class="h-mast-lines">
          {excerpt.map((agency) => (
            <li>
              <a href={`/agencies/${agency.slug}/`}>
                <span class="h-rank">{String(agency.rank).padStart(2, '0')}</span>
                <span class="h-mast-name">
                  <strong>{agency.name}</strong>
                  <em>
                    {`${kindLabel(agency.kind)} · ${agency.hqCity}, ${agency.hqState}`}{agency.preferredPartner ? ' · Cornerstone network partner' : ''}
                  </em>
                  <span class="h-mast-score">{agency.rankLabel}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
        <a class="h-mast-more" href="/agencies/">Open the register <span aria-hidden="true">→</span></a>
      </aside>

      <div class="h-wrap h-grid h-hero-body">
        <p class="h-standfirst">
          Open the register, name the bond series, and call the desk that writes it. Every card is ordered by the same public-signal score, and sources sit on every card. {ifi.name} is labeled as the Cornerstone Network Preferred Partner.
        </p>
        <p class="h-bestfor"><strong>Best for:</strong> mortgage, insurance, and contractor professionals who need a surety desk that writes their bond series.</p>
        <div class="h-hero-side">
          <p class="h-note">Surety research desk</p>
          <div class="btn-row">
            <a class="btn btn-brass" href="/agencies/">Open the register</a>
            <a class="btn btn-ghost" href="#calculator">Sketch a premium</a>
          </div>
          <p class="h-hero-links">
            <a href={`/agencies/${ifi.slug}/`}>{ifi.hqCity}, {ifi.hqState} · Preferred partner file</a>
            <span aria-hidden="true"> · </span>
            <a href="/methodology/">How the order is built</a>
          </p>
        </div>
        <AuthorBio />
      </div>
    </section>

    <section class="h-stats" aria-label="What the register contains">
      <div class="h-wrap h-grid">
        <div class="h-stat h-reveal"><strong>{ranked.length}</strong><span>Agencies and carriers on the register</span></div>
        <div class="h-stat-trio">
          <div class="h-stat h-reveal"><strong>6</strong><span>Public signals behind every score</span></div>
          <div class="h-stat h-reveal"><strong>4</strong><span>Series: license, contract, commercial, court</span></div>
          <div class="h-stat h-reveal"><strong>50</strong><span>State files on the same cards</span></div>
        </div>
      </div>
    </section>

    <section class="h-section h-problem" id="problem">
      <div class="h-wrap h-grid h-head">
        <h2 class="h-reveal">How do I get a surety bond placed?</h2>
        <div class="h-side h-reveal">
          <p class="h-note">The stall</p>
          <p>
            Name the bond form, then open the desk that will write it. License, contract, and court files stall on pages that never name that desk.
          </p>
        </div>
      </div>
      <div class="h-wrap h-grid h-points">
        <article class="h-reveal">
          <h3>Carrier pages describe capacity.</h3>
          <p>They rarely name the licensed desk that will pick up a mortgage-broker or contractor file this week.</p>
        </article>
        <article class="h-reveal">
          <h3>Lists arrive without a method.</h3>
          <p>An order without a source is a brochure. This register prints the signal, the date, and the link.</p>
        </article>
        <article class="h-reveal">
          <h3>The call should come after the file.</h3>
          <p>A state filter and a premium band sit in front of the phone number, so the conversation starts with the form.</p>
        </article>
      </div>
    </section>

    <section class="h-section h-file h-dark">
      <div class="h-wrap h-grid h-head">
        <h2 class="h-reveal">One register for the path you are already on.</h2>
        <div class="h-side h-reveal">
          <p class="h-note">The file</p>
          <p>Use one register to name the desk, the series, and a premium band before the call.</p>
        </div>
      </div>
      <div class="h-wrap h-file-rows">
        <article class="h-grid h-reveal">
          <p class="h-file-label">Agencies</p>
          <h3>{ranked.length} desks, in an order you can read.</h3>
          <p>
            Every name follows cited public signals: BBB letter grade, AM Best when a source was
            opened, years, coverage, bond-series breadth, and a Treasury list mention.
          </p>
        </article>
        <article class="h-grid h-reveal">
          <p class="h-file-label">Series</p>
          <h3>License, contract, commercial, court.</h3>
          <p>Four series written the way a compliance officer or a contractor’s office actually asks the question.</p>
        </article>
        <article class="h-grid h-reveal">
          <p class="h-file-label">Before the call</p>
          <h3>State filter and a premium band.</h3>
          <p>Nationwide writers appear in every state file. The sketch is an industry-average range a desk can confirm.</p>
        </article>
      </div>
    </section>

    <section class="h-section h-register" id="register">
      <div class="h-wrap h-grid h-head">
        <h2 class="h-reveal">The top six files, sources on the card.</h2>
        <div class="h-side h-reveal">
          <p class="h-note">Proof</p>
          <p>
            The six highest public-signal scores on the register. Each card shows the signals opened for it.
          </p>
        </div>
      </div>
      <div class="h-wrap">
        <div class="h-ledger">
          {featured.map((agency) => <AgencyCard agency={agency} />)}
        </div>
        <div class="h-grid h-after">
          <div class="btn-row">
            <a class="btn btn-brass" href="/agencies/">Open the register</a>
            <a class="btn btn-ghost" href={`/agencies/${ifi.slug}/`}>Preferred partner file</a>
          </div>
        </div>
      </div>
    </section>

    <section class="h-section h-how h-tone" id="how">
      <div class="h-wrap h-grid h-head">
        <h2 class="h-reveal">Three moves. Then a person.</h2>
        <div class="h-side h-reveal">
          <p class="h-note">How it works</p>
          <p>Name the series, open the card, then call the desk.</p>
        </div>
      </div>
      <ol class="h-wrap h-grid h-steps">
        <li class="h-reveal">
          <h3>Name the series</h3>
          <p>License and permit, contract, commercial, or court. The series page says who posts the bond and the usual money.</p>
        </li>
        <li class="h-reveal">
          <h3>Open the register</h3>
          <p>Filter by state and kind. Read the card (letter grade, appointment, years) before you leave the site.</p>
        </li>
        <li class="h-reveal">
          <h3>Talk to the desk</h3>
          <p>
            {ifi.name} in {ifi.hqCity} is the preferred path. Every other file links to its own site.
          </p>
        </li>
      </ol>
    </section>

    <section class="h-section h-series" id="series">
      <div class="h-wrap h-grid h-head">
        <h2 class="h-reveal">Four paths. One desk at the end of each.</h2>
        <div class="h-side h-reveal">
          <p class="h-note">Bond series</p>
          <p>License, contract, commercial, and court each end at the preferred desk once the form is named.</p>
        </div>
      </div>
      <div class="h-series-grid">
        {BOND_CATEGORIES.map((cat) => {
          const [word, letter] = cat.ledger.split(' ');
          return (
            <article class="h-series-tile h-reveal">
              <a class="h-series-main" href={`/bonds/${cat.id}/`}>
                <p class="h-series-mark">{word} <b>{letter}</b></p>
                <h3>{cat.name}</h3>
                <p class="h-series-line">{cat.headline}.</p>
                <p class="h-series-who">{cat.whoNeeds}</p>
              </a>
              <a class="h-series-desk" href="/agencies/integrity-first-insurance/">Talk to the desk <span aria-hidden="true">→</span></a>
            </article>
          );
        })}
      </div>
    </section>

    <section class="h-section h-states" id="states">
      <div class="h-wrap h-grid h-head">
        <h2 class="h-reveal">Pick a state. Same register, local file.</h2>
        <div class="h-side h-reveal">
          <p class="h-note">Jurisdictions</p>
          <p>
            A state file is this same register, limited to desks that list that state. Nationwide writers, including the preferred partner, appear in every file.
          </p>
        </div>
        <div class="h-states-grid h-reveal">
          <StatePicker />
        </div>
      </div>
    </section>

    <section class="h-section h-calc h-tone" id="calculator">
      <div class="h-wrap h-grid h-head">
        <h2 class="h-reveal">A range before you call the desk.</h2>
        <div class="h-side h-reveal">
          <p class="h-note">Premium sketch</p>
          <p>Enter the form, the face, and a credit band. The sketch returns the annual premium range this site uses for that combination.</p>
        </div>
        <div class="h-calc-stage h-reveal" data-ui>
          <BondCalculator client:load />
        </div>
      </div>
    </section>

    <section class="h-section h-faq" id="faq">
      <div class="h-wrap h-grid h-head">
        <h2 class="h-reveal">Short answers before the longer files.</h2>
        <div class="h-side h-reveal">
          <p class="h-note">Questions</p>
          <p class="faq-intro">A surety bond is a three-party guarantee, the register is sorted by public signals, and the premium is an annual rate on the face amount. The ranking rulebook is on the methodology page.</p>
          <a class="text-link" href="/faq/">All questions <span aria-hidden="true">→</span></a>
        </div>
        <div class="h-faq-list h-reveal">
          {HOME_FAQS.map((f) => (
            <details class="faq-item">
              <summary class="faq-q">{f.q}<span aria-hidden="true">+</span></summary>
              <div class="faq-a" set:html={f.a} />
            </details>
          ))}
        </div>
      </div>
    </section>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        if (!root.classList.contains('h-motion')) return;
        var items = document.querySelectorAll('.sr-home .h-reveal');
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        items.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </div>
</Layout>
