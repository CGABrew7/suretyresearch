---
import Layout from '../layouts/Layout.astro';
import AgencyCard from '../components/AgencyCard.astro';
import StatePicker from '../components/StatePicker.astro';
import BondCalculator from '../components/BondCalculator.jsx';
import { rankedDirectory } from '../lib/ranking';
import { BOND_CATEGORIES } from '../data/categories';
import { SITE } from '../data/site';

const ranked = rankedDirectory();
const featured = ranked.slice(0, 6);
const ifi = ranked[0];
---

<Layout title="SuretyResearch — the surety agency register" description={SITE.description}>
  <section class="desk">
    <div class="desk-copy">
      <p class="kicker">File 01 · Agency register</p>
      <h1>Find the desk that can actually place the bond.</h1>
      <p class="lede">
        A ranked directory of surety agencies and carriers for mortgage, insurance, and contractor
        professionals. Integrity First Insurance is #1 because it is our Cornerstone Network
        Preferred Partner — an editorial placement, not a fabricated five-star score.
      </p>
      <div class="btn-row">
        <a class="btn btn-brass" href="/agencies/">Open the register</a>
        <a class="btn btn-ghost" href="/agencies/integrity-first-insurance/">IFI #1 file</a>
        <a class="btn btn-ghost" href="/methodology/">How ranks work</a>
      </div>
    </div>
    <div class="desk-stage">
      <figure class="window-pane">
        <img
          src="/media/window.jpg"
          alt="A green plaster wall and a black floor lamp in daylight — a quiet office interior."
          width="1600"
          height="1071"
        />
        <figcaption>Daylight on the blotter</figcaption>
      </figure>
      <a class="ifi-folder" href="/agencies/integrity-first-insurance/">
        <span class="rubber-stamp" aria-hidden="true">
          <strong>01</strong>
          Preferred<br />partner
        </span>
        <h2>{ifi.name}</h2>
        <p>{ifi.editorialReason}</p>
        <p class="folder-meta">{ifi.hqCity}, {ifi.hqState} · Cornerstone Network Preferred Partner</p>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="stat-row">
        <div><strong>{ranked.length}</strong><span>Agencies &amp; carriers on the register</span></div>
        <div><strong>01</strong><span>IFI — preferred partner, labeled</span></div>
        <div><strong>4</strong><span>Bond series: license, contract, commercial, court</span></div>
        <div><strong>50</strong><span>State picker — filter the same cards</span></div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">The register</p>
          <h2>Ranked desks, sources on the card</h2>
        </div>
        <p>
          After IFI, order follows live-cited public signals: BBB letter grades, AM Best (when we
          opened a source), years, coverage, and bond-category breadth. Missing data is omitted — never invented.
        </p>
      </div>
      <div class="ledger">
        {featured.map((agency) => <AgencyCard agency={agency} />)}
      </div>
      <p style="margin-top:22px">
        <a href="/agencies/">Full register ({ranked.length} entries) →</a>
      </p>
    </div>
  </section>

  <section class="workbench">
    <div class="wrap work-photo">
      <figure>
        <img
          src="/media/desk.jpg"
          alt="Hands writing on a stack of bond papers with a mechanical pencil."
          width="1600"
          height="1068"
        />
        <figcaption>Unsplash · underwriter’s desk, not a stock handshake</figcaption>
      </figure>
      <div>
        <p class="kicker">Why the mess</p>
        <h2 class="serif" style="font-size:clamp(1.8rem,3vw,2.5rem);color:#f3e6c4;margin:10px 0 14px">
          Bonds still move on paper. So does this site.
        </h2>
        <p>
          A surety file is a manila folder, a stamp, and a person who will pick up the phone.
          We kept the register honest: IFI is first because we say so, in print, as the
          Cornerstone Network Preferred Partner — not because a generator invented stars.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">Series A–D</p>
          <h2>Bond types, written like a clerk would</h2>
        </div>
        <p>SuretyBonds.com-style clarity on what the bond is for. We remain a directory, not a clone of their brand.</p>
      </div>
      <div class="grid-2">
        {BOND_CATEGORIES.map((cat) => (
          <a class="tile" href={`/bonds/${cat.id}/`}>
            <p class="kicker">{cat.ledger}</p>
            <h3>{cat.name}</h3>
            <p>{cat.headline}. {cat.summary}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">Jurisdictions</p>
          <h2>Pick a state. Same register, filtered.</h2>
        </div>
        <p>
          Nationwide writers appear in every state file. IFI appears because Cornerstone-network
          placement covers multi-state licensees — we do not claim IFI holds a resident license in all 50.
        </p>
      </div>
      <StatePicker />
    </div>
  </section>

  <section class="section" id="calculator" style="padding-top:12px">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">Premium sketch</p>
          <h2>A range before you call the desk</h2>
        </div>
        <p>Industry-average bands only. Your actual rate is underwritten. After the estimate, talk to IFI / Cornerstone.</p>
      </div>
      <BondCalculator client:load />
    </div>
  </section>
</Layout>
