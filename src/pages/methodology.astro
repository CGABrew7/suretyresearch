---
import Layout from '../layouts/Layout.astro';
import { directory, kindLabel } from '../lib/ranking';
import { SITE } from '../data/site';

const agencies = directory();
---

<Layout
  title="Methodology — SuretyResearch"
  description="How SuretyResearch files are built. Names are listed A to Z. Each card shows cited public signals."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">House rules</p>
      <h1>How the register is built.</h1>
      <p>
        Each file shows public signals we opened, with the date and the source.
        {SITE.affiliation}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <h2>What a card can show</h2>
      <ul>
        <li>BBB letter grade, when a BBB page was opened.</li>
        <li>AM Best, when a company page or snippet was opened.</li>
        <li>Year founded, when we have it.</li>
        <li>Nationwide placement, or the states we can show.</li>
        <li>Bond series listed on the file: license, contract, commercial, court.</li>
        <li>A Treasury or Circular 570 mention, when we cited one.</li>
      </ul>
      <p>A blank field means that signal is not in the file.</p>

      <h2>How names are listed</h2>
      <p>Names run A to Z. {agencies.length} files are in this build.</p>

      <div class="table-scroll">
        <table class="table">
          <thead>
            <tr><th>Name</th><th>Kind</th><th>City</th></tr>
          </thead>
          <tbody>
            {agencies.map((a) => (
              <tr>
                <td><a href={`/agencies/${a.slug}/`}>{a.name}</a></td>
                <td>{kindLabel(a.kind)}</td>
                <td>{a.hqCity}, {a.hqState}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2>Signal dates</h2>
      <p>
        Signal dates are stamped <code>2026-08-23</code> for this build. Follow the
        source URL on each card before you bid a job or file a license.
      </p>
    </div>
  </section>
</Layout>
