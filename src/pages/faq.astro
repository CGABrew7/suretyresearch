---
import Layout from '../layouts/Layout.astro';
import { FAQS } from '../data/faqs';
---

<Layout
  title="FAQ — SuretyResearch"
  description="Surety bond questions, and how the SuretyResearch files are built."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">Questions</p>
      <h1>Short answers. The longer files live on the register.</h1>
      <p>How the files are built is written out on the methodology page.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap faq-stack">
      {FAQS.map((f) => (
        <details class="faq-item">
          <summary class="faq-q">{f.q}<span aria-hidden="true">+</span></summary>
          <div class="faq-a" set:html={f.a} />
        </details>
      ))}
      <p class="faq-foot">
        <a class="btn btn-brass" href="/agencies/">Open the register</a>
      </p>
    </div>
  </section>
</Layout>
