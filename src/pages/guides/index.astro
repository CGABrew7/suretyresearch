---
import Layout from '../../layouts/Layout.astro';
import AuthorBio from '../../components/AuthorBio.astro';
import '../../styles/register.css';

const guides = [
  { slug: "best-surety-bond-companies", title: "Best surety bond companies", desc: "A 2026 buyer's shortlist ordered by published AM Best ratings and Treasury Circular 570 limits." },
  { slug: "how-to-find-a-surety-bond-agency", title: "How to find a surety bond agency", desc: "Name the series, open the register, and read the card before you call." },
  { slug: "how-surety-bonds-work", title: "How surety bonds work", desc: "Three parties, indemnity, and when a license or a jobsite will not move without paper." },
  { slug: "credit-score-impact", title: "Credit and premium", desc: "Why credit prices the bond, and what weak files still can do." },
  { slug: "bond-vs-insurance", title: "Bonds vs. insurance", desc: "Who gets paid, who reimburses, and when you need both." },
];
---

<Layout register title="Guides | SuretyResearch" description="Plain-English surety guides for licensed professionals.">
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">Research notes</p>
      <h1 class="h-t1">Guides that stay useful after the register.</h1>
      <p>Each guide opens with the answer, then the detail a desk needs before it places the bond.</p>
      <AuthorBio />
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      {guides.map((g) => (
        <a href={`/guides/${g.slug}/`} class="tile">
          <p class="kicker">Guide</p>
          <h3>{g.title}</h3>
          <p>{g.desc}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
