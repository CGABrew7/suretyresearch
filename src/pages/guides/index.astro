---
import Layout from '../../layouts/Layout.astro';

const guides = [
  { slug: "how-surety-bonds-work", title: "How surety bonds work", desc: "Three parties, indemnity, and when a license or a jobsite will not move without paper." },
  { slug: "credit-score-impact", title: "Credit and premium", desc: "Why credit prices the bond, and what weak files still can do." },
  { slug: "bond-vs-insurance", title: "Bonds vs. insurance", desc: "Who gets paid, who reimburses, and when you need both." },
];
---

<Layout title="Guides — SuretyResearch" description="Plain-English surety guides for licensed professionals.">
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">Research notes</p>
      <h1>Guides that stay useful after the register.</h1>
    </div>
  </section>
  <section class="section">
    <div class="wrap" style="max-width:720px">
      {guides.map((g) => (
        <a href={`/guides/${g.slug}/`} class="tile" style="margin-bottom:12px">
          <p class="kicker">Guide</p>
          <h3>{g.title}</h3>
          <p>{g.desc}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
