---
import Layout from '../../layouts/Layout.astro';
import { AGENCIES } from '../../data/agencies';
import { rankedDirectory, kindLabel } from '../../lib/ranking';
import { BOND_CATEGORIES } from '../../data/categories';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  return AGENCIES.map((agency) => ({ params: { slug: agency.slug } }));
}

const { slug } = Astro.params;
const ranked = rankedDirectory();
const agency = ranked.find((a) => a.slug === slug);
if (!agency) throw new Error(`Missing agency ${slug}`);

const cats = BOND_CATEGORIES.filter((c) => agency.categories.includes(c.id));
---

<Layout
  title={`${agency.name} — SuretyResearch register #${String(agency.rank).padStart(2, '0')}`}
  description={agency.summary}
>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">
        File {String(agency.rank).padStart(2, '0')} · {kindLabel(agency.kind)} · {agency.hqCity}, {agency.hqState}
      </p>
      <h1>{agency.name}</h1>
      <p>{agency.tagline}</p>
      <div class="card-meta" style="margin-top:14px">
        {agency.preferredPartner && <span class="pill seal">Cornerstone Network Preferred Partner</span>}
        <span class="pill">{kindLabel(agency.kind)}</span>
        {agency.foundedYear && <span class="pill">Founded {agency.foundedYear}</span>}
        {agency.servesNationwide && <span class="pill">Nationwide placement listed</span>}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid-2">
      <div class="prose">
        {agency.preferredPartner && (
          <div class="cert" style="margin-bottom:22px;overflow:hidden">
            <span class="rubber-stamp" aria-hidden="true" style="position:absolute;right:12px;top:18px">
              <strong>01</strong>
              Preferred<br />partner
            </span>
            <p class="kicker">Why this file is #1</p>
            <p style="margin-top:8px;padding-right:90px">{agency.editorialReason}</p>
            <p style="margin-bottom:0;padding-right:90px">
              We do not claim IFI is the largest U.S. surety, the cheapest market, or “#1 in America.”
              Preferred-partner / editor’s rank is the honest label.
            </p>
          </div>
        )}
        <p>{agency.summary}</p>
        {agency.detail.map((p) => <p>{p}</p>)}

        {agency.notes.length > 0 && (
          <>
            <h2>What we will not stretch</h2>
            <ul>
              {agency.notes.map((n) => <li>{n}</li>)}
            </ul>
          </>
        )}
      </div>

      <aside>
        <div class="cert">
          <p class="kicker">Public signals</p>
          <table class="table" style="margin-top:10px">
            <thead>
              <tr><th>Signal</th><th>Value</th></tr>
            </thead>
            <tbody>
              {agency.signals.map((s) => (
                <tr>
                  <td>
                    <strong>{s.label}</strong>
                    <div style="color:var(--ink-3);font-size:0.78rem;margin-top:4px">
                      {s.sourceUrl ? <a href={s.sourceUrl}>{s.source}</a> : s.source}
                      {' · '}as of {s.asOf}
                    </div>
                  </td>
                  <td>{s.value}</td>
                </tr>
              ))}
            </tbody>
          </table>
          {!agency.preferredPartner && (
            <p style="font-size:0.85rem;color:var(--ink-3);margin-top:12px">
              Public-signal score {agency.score}. Breakdown:
              {agency.scoreBreakdown.map((row) => ` ${row.label} ${row.points};`)}
            </p>
          )}
        </div>

        <div class="cert" style="margin-top:18px">
          <p class="kicker">{agency.preferredPartner ? 'Call this desk' : 'Need a bond placed?'}</p>
          <p style="margin:10px 0 14px;color:var(--ink-2)">
            {agency.preferredPartner
              ? 'IFI / Cornerstone is the preferred path from this register.'
              : 'This listing is research. For placement through our preferred partner, use IFI / Cornerstone.'}
          </p>
          <div class="btn-row" style="margin-top:0">
            {agency.preferredPartner ? (
              <>
                <a class="btn btn-brass" href={`tel:${SITE.ifi.phone.replace(/-/g, '')}`}>{SITE.ifi.phone}</a>
                <a class="btn" href={agency.website} target="_blank" rel="noopener">IFI website</a>
                <a class="btn" href={SITE.ifi.cornerstoneSurety} target="_blank" rel="noopener">Cornerstone Surety</a>
              </>
            ) : (
              <>
                <a class="btn btn-brass" href="/agencies/integrity-first-insurance/">Talk to IFI</a>
                <a class="btn" href={agency.website} target="_blank" rel="noopener">Their site</a>
              </>
            )}
          </div>
          {agency.phone && !agency.preferredPartner && (
            <p style="margin-top:12px;font-size:0.9rem">Published phone: {agency.phone}</p>
          )}
          {agency.address && <p style="margin-top:10px;font-size:0.9rem">{agency.address}</p>}
        </div>
      </aside>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">Bond series on this file</p>
          <h2>What they claim to write</h2>
        </div>
      </div>
      <div class="grid-2">
        {cats.map((cat) => (
          <a class="tile" href={`/bonds/${cat.id}/`}>
            <p class="kicker">{cat.ledger}</p>
            <h3>{cat.name}</h3>
            <p>{cat.summary}</p>
          </a>
        ))}
      </div>

      {agency.audiences.length > 0 && (
        <p style="margin-top:18px;color:var(--ink-2)">
          Typical desks: {agency.audiences.join(' · ')}
        </p>
      )}

      <h2 class="serif" style="margin:28px 0 10px;font-size:1.3rem">Sources</h2>
      <ul class="source-list">
        {agency.sources.map((s) => (
          <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>
        ))}
        {agency.relatedLinks?.map((s) => (
          <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
