---
import Layout from '../../layouts/Layout.astro';
import AgencyCard from '../../components/AgencyCard.astro';
import { directory } from '../../lib/ranking';
import { STATES } from '../../data/states';
import { SITE } from '../../data/site';

const agencies = directory();
---

<Layout
  title="Agency register — SuretyResearch"
  description="Directory of surety agencies and carriers, listed A to Z. Each card shows cited BBB, AM Best, years, and coverage signals."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">The register · {agencies.length} desks</p>
      <h1>Agencies and carriers, listed A to Z.</h1>
      <p>
        {SITE.affiliation}
        Each card shows cited public signals. The method is on the <a href="/methodology/">methodology</a> page.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">

      <div class="filters" id="register-filters">
        <label>
          State
          <select name="state">
            <option value="">All states</option>
            {STATES.map((s) => (
              <option value={s.code}>{s.code} — {s.name}</option>
            ))}
          </select>
        </label>
        <label>
          Bond series
          <select name="category">
            <option value="">All bond series</option>
            <option value="license-permit">License &amp; permit</option>
            <option value="contract">Contract / performance</option>
            <option value="commercial">Commercial</option>
            <option value="court">Court / judicial</option>
          </select>
        </label>
        <label>
          Kind
          <select name="kind">
            <option value="">All kinds</option>
            <option value="agency">Agencies</option>
            <option value="carrier">Carriers</option>
            <option value="marketplace">Marketplaces</option>
          </select>
        </label>
        <label>
          Find
          <input type="search" name="q" placeholder="Name or city" />
        </label>
      </div>

      <p class="disclaimer" id="register-count" style="margin-bottom:16px">
        Showing {agencies.length} of {agencies.length} register entries.
      </p>

      <div class="ledger" id="register-list">
        {agencies.map((agency) => <AgencyCard agency={agency} />)}
      </div>
    </div>
  </section>
</Layout>

<script>
  const root = document.getElementById('register-filters');
  const list = document.getElementById('register-list');
  const count = document.getElementById('register-count');
  if (root && list && count) {
    const cards = [...list.querySelectorAll('.agency-card')];
    const total = cards.length;
    const apply = () => {
      const state = (root.querySelector('[name="state"]') as HTMLSelectElement).value;
      const category = (root.querySelector('[name="category"]') as HTMLSelectElement).value;
      const kind = (root.querySelector('[name="kind"]') as HTMLSelectElement).value;
      const q = (root.querySelector('[name="q"]') as HTMLInputElement).value.trim().toLowerCase();
      let shown = 0;
      for (const card of cards) {
        const okKind = !kind || card.getAttribute('data-kind') === kind;
        const cats = (card.getAttribute('data-categories') || '').split(',');
        const okCat = !category || cats.includes(category);
        const nationwide = card.getAttribute('data-nationwide') === '1';
        const states = (card.getAttribute('data-states') || '').split(',');
        const okState = !state || nationwide || states.includes(state);
        const hay = card.getAttribute('data-search') || '';
        const okQ = !q || hay.includes(q);
        const show = okKind && okCat && okState && okQ;
        (card as HTMLElement).style.display = show ? '' : 'none';
        if (show) shown += 1;
      }
      count.textContent = `Showing ${shown} of ${total} register entries.`;
    };
    root.addEventListener('change', apply);
    root.addEventListener('input', apply);
  }
</script>
