---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Privacy — SuretyResearch" description="SuretyResearch privacy notes.">
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">Housekeeping</p>
      <h1>Privacy</h1>
      <p>Last updated August 2026.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap prose">
      <p>
        This is a static research site. The premium sketch runs in your browser. We do not operate a
        lead form that quietly sells your name.
      </p>
      <p>
        If you call Integrity First Insurance or Cornerstone, you are dealing with those firms and
        their privacy notices — not with a fake intermediary inbox.
      </p>
      <p>
        Hosting (Cloudflare Pages) and fonts (Google Fonts) may process standard request logs and
        font requests. We do not run advertising pixels on this build.
      </p>
      <p>Directory questions: bonds@suretyresearch.com</p>
    </div>
  </section>
</Layout>
