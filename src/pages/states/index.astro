---
import Layout from '../../layouts/Layout.astro';
import StatePicker from '../../components/StatePicker.astro';
---

<Layout
  title="Bonds by state — SuretyResearch"
  description="Filter the surety agency register by U.S. state. Nationwide writers appear in every file."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">Jurisdictions</p>
      <h1>Same register. A local heading.</h1>
      <p>
        Choose a state. Nationwide writers appear in every file. Resident appointments are printed on each agency file.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <StatePicker />
    </div>
  </section>
</Layout>
