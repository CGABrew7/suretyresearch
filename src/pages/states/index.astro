---
import Layout from '../../layouts/Layout.astro';
import AuthorBio from '../../components/AuthorBio.astro';
import StatePicker from '../../components/StatePicker.astro';
---

<Layout
  title="Bonds by state — SuretyResearch"
  description="Filter the surety agency register by U.S. state. Nationwide writers appear in every file. IFI is labeled as the Cornerstone network desk."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">Jurisdictions</p>
      <h1>Same register. A local heading.</h1>
      <p>
        Choose a state and the register shows the desks that list coverage there. Nationwide writers, including Integrity First Insurance, appear in every file.
      </p>
      <AuthorBio />
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <StatePicker />
    </div>
  </section>
</Layout>
