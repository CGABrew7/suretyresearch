---
import '../styles/global.css';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const {
  title,
  description = SITE.description,
  canonical,
} = Astro.props;

const canonicalUrl = canonical
  ? new URL(canonical, SITE.url).toString()
  : new URL(Astro.url.pathname, SITE.url).toString();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#163044" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to register</a>
    <header class="site-header" id="site-header">
      <div class="wrap header-bar">
        <a class="brand" href="/">
          <span class="brand-mark">SR</span>
          <span class="brand-name">
            SuretyResearch
            <span>Agency register · est. ledger 2026</span>
          </span>
        </a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links">Menu</button>
        <nav class="nav-links" id="nav-links">
          <a href="/agencies/">Agencies</a>
          <a href="/bonds/">Bond types</a>
          <a href="/states/">States</a>
          <a href="/methodology/">Methodology</a>
          <a href="/guides/">Guides</a>
          <a class="nav-cta" href="/agencies/integrity-first-insurance/">Contact IFI</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <section class="cta-band">
      <div class="wrap">
        <p class="kicker">Preferred desk</p>
        <h2>Need a bond placed — not another sales form?</h2>
        <p>
          Integrity First Insurance is our Cornerstone Network Preferred Partner. Call the
          Georgia desk or open a Cornerstone surety request. Licensed placement. Not legal advice.
        </p>
        <div class="btn-row">
          <a class="btn btn-brass" href={`tel:${SITE.ifi.phone.replace(/-/g, '')}`}>Call {SITE.ifi.phone}</a>
          <a class="btn btn-ghost" href={SITE.ifi.cornerstoneSurety} target="_blank" rel="noopener">Cornerstone Surety</a>
          <a class="btn btn-ghost" href="/agencies/integrity-first-insurance/">IFI register page</a>
        </div>
      </div>
    </section>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <a class="brand" href="/" style="margin-bottom:10px">
              <span class="brand-mark">SR</span>
              <span class="brand-name">SuretyResearch<span>Directory + research</span></span>
            </a>
            <p>
              A ranked register of surety agencies and carriers for mortgage, insurance, and
              contractor professionals. Editorial rank #1 is IFI — labeled, not a fake star score.
            </p>
          </div>
          <div>
            <h4>Register</h4>
            <a href="/agencies/">All agencies</a>
            <a href="/agencies/integrity-first-insurance/">Integrity First Insurance</a>
            <a href="/states/">By state</a>
            <a href="/methodology/">How ranking works</a>
          </div>
          <div>
            <h4>Bond ledgers</h4>
            <a href="/bonds/license-permit/">License &amp; permit</a>
            <a href="/bonds/contract/">Contract / performance</a>
            <a href="/bonds/commercial/">Commercial</a>
            <a href="/bonds/court/">Court / judicial</a>
          </div>
          <div>
            <h4>House</h4>
            <a href="/about/">About</a>
            <a href="/guides/">Guides</a>
            <a href="/faq/">FAQ</a>
            <a href="/contact/">Contact</a>
            <a href="/privacy/">Privacy</a>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© 2026 SuretyResearch · {SITE.owner}</span>
          <span>Informational only. Bonds are issued by licensed agents and admitted sureties. Not legal advice.</span>
        </div>
      </div>
    </footer>

    <script>
      const header = document.getElementById('site-header');
      const toggle = header?.querySelector('.nav-toggle');
      toggle?.addEventListener('click', () => {
        const open = header?.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    </script>
  </body>
</html>
