---
import '../styles/global.css';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const {
  title,
  description = SITE.description,
  canonical,
} = Astro.props;

const canonicalUrl = canonical
  ? new URL(canonical, SITE.url).toString()
  : new URL(Astro.url.pathname, SITE.url).toString();

const phoneHref = `tel:${SITE.ifi.phone.replace(/-/g, '')}`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c1424" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Newsreader:ital,opsz,wght@0,6..72,500;0,6..72,600;1,6..72,500&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header" id="site-header">
      <div class="wrap header-bar">
        <a class="brand" href="/">
          <img src="/logo-lockup.png" alt="SuretyResearch" style="height:56px;width:auto;display:block" />
        </a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links">Menu</button>
        <nav class="nav-links" id="nav-links">
          <a href="/agencies/">Agencies</a>
          <a href="/bonds/">Bond types</a>
          <a href="/states/">States</a>
          <a href="/methodology/">Methodology</a>
          <a href="/guides/">Guides</a>
          <a class="nav-cta" href="/agencies/">Open the register</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <section class="cta-band">
      <div class="wrap">
        <p class="kicker">The desk</p>
        <h2>The register is open. The Alpharetta desk answers.</h2>
        <p>{SITE.affiliation}</p>
        <p>Open the Integrity First file, or call {SITE.ifi.phone}.</p>
        <div class="btn-row">
          <a class="btn btn-brass" href="/agencies/">Open the register</a>
          <a class="btn btn-ghost" href={phoneHref}>Call {SITE.ifi.phone}</a>
          <a class="btn btn-ghost" href={SITE.ifi.cornerstoneSurety} target="_blank" rel="noopener">Cornerstone Surety</a>
        </div>
      </div>
    </section>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <a class="brand" href="/">
              <img src="/logo-lockup.png" alt="SuretyResearch" style="height:64px;width:auto;display:block" />
            </a>
            <p class="footer-note">{SITE.affiliation}</p>
          </div>
          <div class="footer-links">
            <p class="footer-label">Register</p>
            <a href="/agencies/">All agencies</a>
            <a href="/agencies/integrity-first-insurance/">Integrity First Insurance</a>
            <a href="/states/">By state</a>
            <a href="/methodology/">How the register works</a>
          </div>
          <div class="footer-links">
            <p class="footer-label">Bond series</p>
            <a href="/bonds/license-permit/">License &amp; permit</a>
            <a href="/bonds/contract/">Contract / performance</a>
            <a href="/bonds/commercial/">Commercial</a>
            <a href="/bonds/court/">Court / judicial</a>
          </div>
          <div class="footer-links">
            <p class="footer-label">House</p>
            <a href="/about/">About</a>
            <a href="/guides/">Guides</a>
            <a href="/faq/">FAQ</a>
            <a href="/contact/">Contact</a>
            <a href="/privacy/">Privacy</a>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© 2026 SuretyResearch · {SITE.owner}</span>
          <span>Informational only. Bonds are issued by licensed agents and admitted sureties. Not legal advice.</span>
        </div>
      </div>
    </footer>

    <div class="mobile-cta">
      <a class="btn btn-brass" href="/agencies/">Open the register</a>
    </div>

    <script>
      const header = document.getElementById('site-header');
      const toggle = header?.querySelector('.nav-toggle');
      toggle?.addEventListener('click', () => {
        const open = header?.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        toggle.textContent = open ? 'Close' : 'Menu';
      });

      const bar = document.querySelector('.mobile-cta');
      const watch = [
        document.getElementById('calculator'),
        document.querySelector('.cta-band'),
        document.querySelector('.site-footer'),
      ].filter(Boolean);
      if (bar && watch.length && 'IntersectionObserver' in window) {
        const visible = new Set();
        const io = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) visible.add(entry.target);
            else visible.delete(entry.target);
          }
          bar.classList.toggle('is-hidden', visible.size > 0);
        }, { threshold: 0.2 });
        watch.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
